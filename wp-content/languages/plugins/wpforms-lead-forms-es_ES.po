#. Plugin Name of the plugin
msgid "WPForms Lead Forms"
msgstr "WPForms Lead Forms"

#. Plugin URI of the plugin
#. Author URI of the plugin
msgid "https://wpforms.com"
msgstr "https://wpforms.com"

#. Description of the plugin
msgid "Create Lead Forms with WPForms."
msgstr "Crea formularios para clientes potenciales con WPForms."

#. Author of the plugin
msgid "WPForms"
msgstr "WPForms"

#: src/Builder.php:81
#: src/Builder.php:99
msgid "Lead Forms"
msgstr "Lead Forms"

#. translators: %s is a link to the WPForms.com documentation article.
#: src/Builder.php:108
msgid "Create an embeddable form with multiple page breaks. Your form will be restructured to include a page break between each field so users only see one field at a time as they progress through the form. You can publish this form in a post, page, or widget area. <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Learn more about Lead Forms.</a>"
msgstr "Crea un formulario incrustable con múltiples saltos de página. Tu formulario se reestructurará para incluir un salto de página entre cada campo, de modo que los usuarios sólo vean un campo cada vez a medida que avanzan por el formulario. Puedes publicar este formulario en una entrada, página o área de widget. <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Más información sobre Lead Forms.</a>"

#: src/Builder.php:128
msgid "Enable Lead Form Mode"
msgstr "Activar el modo de lead form"

#: src/Builder.php:165
msgid "Lead Form Title"
msgstr "Título del lead form"

#: src/Builder.php:168
msgid "Add a title to display above your published form."
msgstr "Añade un título para que aparezca encima de tu formulario publicado."

#: src/Builder.php:177
msgid "Enable Scroll Animation"
msgstr "Activar animación de desplazamiento"

#: src/Builder.php:180
msgid "Enable this option to scroll to the top of the form when the user clicks the next button."
msgstr "Activa esta opción para desplazarte a la parte superior del formulario cuando el usuario haga clic en el botón siguiente."

#: src/Builder.php:189
msgid "Accent Color"
msgstr "Color de énfasis"

#: src/Builder.php:192
msgid "Change the color of your form's buttons, progress bar, and more."
msgstr "Cambia el color de los botones de tu formulario, de la barra de progreso y muchos más elementos."

#: src/Builder.php:204
msgid "Advanced Style Settings"
msgstr "Ajustes de estilo avanzados"

#: src/Builder.php:207
msgid "Enable form container styling and additional color options."
msgstr "Activa el estilo del contenedor del formulario y las opciones de color adicionales."

#: src/Builder.php:226
msgid "Form Container"
msgstr "Contenedor del formulario"

#: src/Builder.php:229
msgid "Show the form container to make your lead form stand out from the page."
msgstr "Muestra el contenedor del formulario para que tu formulario de leads destaque en la página."

#: src/Builder.php:238
msgid "Drop Shadow"
msgstr "Sombra paralela"

#: src/Builder.php:241
msgid "Add a drop shadow to the form container."
msgstr "Añade una sombra paralela al contenedor del formulario."

#: src/Builder.php:250
msgid "Rounded Corners"
msgstr "Esquinas Redondeadas"

#: src/Builder.php:253
msgid "Display the form container with rounded corners."
msgstr "Muestra el contenedor del formulario con las esquinas redondeadas."

#: src/Builder.php:264
msgid "Container Background"
msgstr "Fondo del contenedor"

#: src/Builder.php:268
msgid "Change the color of the form container background."
msgstr "Cambia el color del fondo del contenedor del formulario."

#: src/Builder.php:280
msgid "Field Borders"
msgstr "Bordes de campo"

#: src/Builder.php:284
msgid "Change the color of the field borders."
msgstr "Cambia el color de los bordes de los campos."

#: src/Builder.php:300
msgid "Primary Text"
msgstr "Texto principal"

#: src/Builder.php:304
msgid "Change the color of the primary text (e.g., page titles, field labels)."
msgstr "Cambia el color del texto principal (por ejemplo, títulos de página, etiquetas de campo)."

#: src/Builder.php:316
msgid "Secondary Text"
msgstr "Texto Secundario"

#: src/Builder.php:320
msgid "Change the color of the secondary text (e.g., input text, descriptions)."
msgstr "Cambia el color del texto secundario (por ejemplo, texto de entrada, descripciones)."

#. translators: %s is a link for documentation.
#: src/Builder.php:343
msgid " If you've copied style settings from another lead form, you can paste them here to add the same styling to this form. Any current style settings will be overwritten. See our <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">lead form styling documentation</a> for details."
msgstr " Si has copiado ajustes de estilo de otro formulario de leads, puedes pegarlos aquí para añadir el mismo estilo a este formulario. Cualquier configuración de estilo actual se sobrescribirá. Consulta nuestra <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">documentación</a> sobre el estilo de los formularios de leads para obtener más detalles."

#: src/Builder.php:360
msgid "Import New Style Settings"
msgstr "Importar nuevos ajustes de estilo"

#: src/Builder.php:364
msgid "Paste style settings from another lead form."
msgstr "Pega los ajustes de estilo de otro formulario de leads."

#: src/Builder.php:376
msgid "Export / Import Style Settings"
msgstr "Exportar / Importar ajustes de estilo"

#: src/Builder.php:412
msgid "Export Your Style Settings"
msgstr "Exportar tus ajustes de estilo"

#: src/Builder.php:413
msgid "Copy this form's styles so you can use them in another lead form."
msgstr "Copia los estilos de este formulario para poder utilizarlos en otro formulario de leads."

#. translators: %s is a link to Revisions page.
#: src/Builder.php:465
msgid "Enabling Lead Forms will restructure your form by adding page breaks between each field. You can revert this change using <a href=\"%s\">Revisions</a>."
msgstr "Al activar Lead Forms se reestructurará tu formulario añadiendo saltos de página entre cada campo. Puedes revertir este cambio utilizando <a href=\"%s\">Revisiones</a>."

#. translators: %1$s is a link to documentation.
#: src/Builder.php:487
msgid "If you scroll down and look at your form, you'll notice that page breaks have been inserted after each field. Lead forms typically have <a href=\"%1$s\" target=\"_blank\" rel=\"noopener noreferrer\">1–3 fields per page</a>, so this will help you get your new lead form up and running quickly. Follow the tips below to optimize your lead form. These are completely optional, but will yield the best results!"
msgstr "Si te desplazas hacia abajo y miras tu formulario, verás que se han insertado saltos de página después de cada campo. Los formularios de Lead Forms suelen tener <a href=\"%1$s\" target=\"_blank\" rel=\"noopener noreferrer\">de 1 a 3 campos por página</a>, así que esto te ayudará a poner en marcha rápidamente tu nuevo formulario. Sigue los siguientes consejos para optimizar tu formulario de captación de clientes potenciales. Son completamente opcionales, ¡pero te darán los mejores resultados!"

#: src/Builder.php:488
msgid "<strong>Create big, bold headings.</strong> Instead of using standard field labels, try using page titles. Click on a Page Break to add a page title. Be sure to hide each field's label in its field options as well."
msgstr "<strong>Crea títulos grandes y en negrita.</strong> En lugar de utilizar etiquetas de campo estándar, prueba a utilizar títulos de página. Haz clic en Salto de Página para añadir un título de página. Asegúrate también de ocultar la etiqueta de cada campo en sus opciones de campo."

#: src/Builder.php:489
msgid "<strong>Consolidate pages, if necessary.</strong> Each field is now on its own page, but you may want to group similar fields on the same page. Drag and drop fields to reorganize them, then delete any Page Breaks you no longer need."
msgstr "<strong>Consolida las páginas, si es necesario.</strong> Cada campo está ahora en su propia página, pero puede que quieras agrupar campos similares en la misma página. Arrastra y suelta los campos para reorganizarlos, y luego borra los saltos de página que ya no necesites."

#: src/Builder.php:490
msgid "<strong>Use icon choices for radio buttons.</strong> Upgrade your standard Multiple Choice field radio buttons to fancy icon choices that look great and convert."
msgstr "<strong>Utiliza opciones de icono para los botones de opción.</strong> Mejora tus botones de opción estándar de los campos de opción múltiple con elegantes opciones de icono que tienen un aspecto estupendo y convierten muy bien."

#: src/Builder.php:491
msgid "<strong>Use placeholders instead of sublabels.</strong> Some fields (Name, Address, etc.) have sublabels. Trying using placeholder text instead."
msgstr "<strong>Utiliza marcadores de posición en lugar de subetiquetas.</strong> Algunos campos (Nombre, Dirección, etc.) tienen subetiquetas. Prueba a utilizar texto de marcador de posición en su lugar."

#. translators: %1$s is a link to documentation.
#: src/Builder.php:493
msgid "For more lead forms tips and best practices, check out our <a href=\"%1$s\" target=\"_blank\" rel=\"noopener noreferrer\">Complete Guide to Lead Forms.</a>"
msgstr "Para más consejos y buenas prácticas revisa nuestra <a href=\"%1$s\" target=\"_blank\" rel=\"noopener noreferrer\">Guía completa de Lead Forms.</a>"

#: src/Builder.php:505
#: templates/builder/warning.php:18
msgid "Lead Forms Enabled"
msgstr "Lead Forms activado"

#: src/Builder.php:506
msgid "Your form has been converted to a lead form. Learn how to format it for maximum impact."
msgstr "Tu formulario se ha convertido en un formulario de leads. Aprende a darle formato para conseguir el máximo impacto."

#: src/Builder.php:507
msgid "Enable Lead Forms"
msgstr "Activar Lead Forms"

#: src/Builder.php:510
msgid "Yes, Import"
msgstr "Sí, importar"

#: src/Builder.php:511
msgid "You're about to overwrite your style settings. Are you sure you want to proceed?"
msgstr "Estás a punto de sobrescribir tus ajustes de estilo. ¿Estás seguro de que quieres continuar?"

#: src/Builder.php:512
msgid "Your import string is invalid. Please check the string and try again."
msgstr "Tu cadena de importación no es válida. Comprueba la cadena e inténtalo de nuevo."

#: src/Builder.php:513
msgid "Lead Forms cannot be enabled because you are in Conversational Forms mode."
msgstr "Lead Forms no puede activarse porque estás en modo formularios conversacionales."

#: src/Builder.php:514
msgid "Lead Forms cannot be enabled because you are in Form Pages mode."
msgstr "Lead Forms no puede activarse porque estás en el modo páginas de formulario."

#: src/Builder.php:515
msgid "You cannot use Conversational Forms in Lead Forms mode."
msgstr "No puedes utilizar formularios conversacionales en el modo formularios de leads."

#: src/Builder.php:516
msgid "You cannot use Form Pages in Lead Forms mode."
msgstr "No puedes utilizar páginas de formulario en el modo formularios de leads."

#: src/Builder.php:518
msgid "You cannot use this field in Lead Forms mode."
msgstr "No puedes utilizar este campo en el modo formularios de leads."

#: src/Builder.php:519
msgid "You cannot use the Entry Preview field in Lead Forms mode."
msgstr "No puedes utilizar el campo vista previa de la entrada en el modo formularios de leads."

#: src/Builder.php:520
msgid "You cannot use the Layout field in Lead Forms mode."
msgstr "No puedes utilizar el campo de diseño en el modo formularios de leads."

#: src/Builder.php:522
msgid "You cannot use this option because you are in Lead Forms mode."
msgstr "No puedes utilizar esta opción porque estás en el modo formularios de leads."

#: src/Builder.php:572
msgid "Just a Minute!"
msgstr "¡Un momento!"

#: src/Builder.php:573
msgid "We're converting your form to a lead form. This could take a little while if your form has lots of fields. Please don't close or reload your browser window."
msgstr "Estamos convirtiendo tu formulario en un formulario de leads. Esto puede tardar un poco si tu formulario tiene muchos campos. Por favor, no cierres ni recargues la ventana de tu navegador."

#. translators: %1$s - a number of already converted fields, %2$s - a number of total fields to convert.
#: templates/builder/loader.php:39
msgid "Converting field %1$s of %2$s"
msgstr "Convirtiendo el campo %1$s de %2$s"

#. translators: %s is a link to the fields tab.
#: templates/builder/warning.php:23
msgid "Before you save, head over to the <a href=\"%s\">Fields tab</a> and make sure everything is formatted the way you would like."
msgstr "Antes de guardar, ve a la <a href=\"%s\">pestaña campos</a> y asegúrate de que todo tiene el formato que deseas."

#: templates/frontend/confirmation-header.php:20
msgid "Thank You!"
msgstr "¡Gracias!"
