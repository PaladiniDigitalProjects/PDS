{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"supports": {
			"renaming": "true",
			"reusable": "true",
			"shadow": "false"
		},

        "custom": {
            "baseFont": 16,
            "lineHeight": {
                "small": 1,
                "medium": 1.2,
                "large": 1.4,
                "body": 1.6,
                "heading": 1.3
            }
        },

		"layout": {
			"contentSize": "986px",
			"wideSize": "1420px"
		},
		
        "border": {
		    "color": true
        },

        "color": {
		    "defaultPalette": false,
            "link": true,
            "gradients": [],
            "customGradient": false,
            "defaultGradients": false,
            "palette": [
                {
                    "slug": "white",
                    "color": "#FFFFFF",
                    "name": "White"
                },
                {
                    "slug": "black",
                    "color": "#000000",
                    "name": "Black"
                },
                {
                    "slug": "bkg",
                    "color": "#343434",
                    "name": "Background"
                }
            ]
	    },

		"typography": {
			"fontSizes": [
				{
					"slug": "small",
					"size": "1.6rem",
					"name": "Small"
				},
                {
					"slug": "regular",
					"size": "2rem",
					"name": "Regular"
				},
				{
					"slug": "medium",
					"size": "3rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "5rem",
					"name": "Large"
				},
				{
					"slug": "extra-large",
					"size": "7.6rem",
					"name": "XL"
				},
                {
					"slug": "extra-extra-large",
					"size": "9rem",
					"name": "XXL"
				}
			],
			"lineHeight": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"units": [ "px", "rem", "vh", "vw", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-2)"
				}
			}
	   },
	   "typography": {
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontFamily": "var(--wp--preset--font-family--system-fonts)",
			"lineHeight": "1.7"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"area": "header",
			"title": "Header"
		},
		{
			"name": "footer",
			"area": "footer",
			"title": "Footer"
		}
	]	
}